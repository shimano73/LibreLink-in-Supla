[Unit]
Description=LibreLinkUp glucose JSON bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wyse
Group=wyse
WorkingDirectory=/home/wyse/libre
EnvironmentFile=/home/wyse/libre/libre.env
ExecStart=/home/wyse/supla-env/bin/python -u /home/wyse/libre/libre_to_json.py
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
